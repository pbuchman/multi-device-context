diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..e1e91dcee17ab16ad404945edf67ed428ea160ba
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Bound all AST nesting, including parentheses and caller-supplied ASTs.
+// Iterative validation itself must not consume the JavaScript call stack.
+const MAX_DEPTH = 128;
+const validateDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH) throw new SyntaxError('Brace nesting exceeds supported depth');
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+module.exports = { MAX_DEPTH, validateDepth };
