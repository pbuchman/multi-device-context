{
  "name": "@mdc/desktop",
  "productName": "Multi Device Context",
  "version": "0.5.6",
  "private": true,
  "description": "Private contexts shared across your computers",
  "author": "Multi Device Context contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:update-harness": "node --test scripts/native-update-fixture.test.mjs scripts/native-system-trust*.test.mjs",
    "test:update-native": "node scripts/native-update-a-to-b.mjs",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "pnpm build && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "@mdc/contracts": "workspace:*",
    "@types/node": "22.19.11",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
